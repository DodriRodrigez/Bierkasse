# Beispiel-Konfiguration für die Bierkasse7-App.
#
#   cp .env.example .env
#
# und die Werte anpassen. Alle Variablen sind optional – ohne .env gelten die
# (unsicheren) Entwicklungs-Standardwerte aus app/config.py.

# ---------------------------------------------------------------------------
# Sicherheit (in Produktion UNBEDINGT setzen!)
# ---------------------------------------------------------------------------
BIERKASSE7_SECRET_KEY=change-me-in-production
BIERKASSE7_DEBUG=false

# ---------------------------------------------------------------------------
# Datenbank (Standard: SQLite-Datei)
# ---------------------------------------------------------------------------
BIERKASSE7_DATABASE_URL=sqlite:///./bierkasse7.db

# ---------------------------------------------------------------------------
# Bootstrap-Konten (werden von den Seed-Skripten angelegt)
# ---------------------------------------------------------------------------
BIERKASSE7_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BIERKASSE7_BOOTSTRAP_ADMIN_PASSWORD=change-me
BIERKASSE7_BOOTSTRAP_MEMBER_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Verrechnungs-E-Mail (SMTP)
# ---------------------------------------------------------------------------
# Ohne smtp_host werden E-Mails nicht versendet, sondern nur im Ordner
# `outbox/` abgelegt. Für lokale Tests reicht der Mailpit-Dienst aus
# (siehe docker-compose.yml, Web-UI unter http://localhost:8025).
# BIERKASSE7_SMTP_HOST=smtp.example.com
# BIERKASSE7_SMTP_PORT=587
# BIERKASSE7_SMTP_STARTTLS=true
# BIERKASSE7_SMTP_SSL=false
# BIERKASSE7_SMTP_USER=verrechnung@example.com
# BIERKASSE7_SMTP_PASSWORD=change-me
# BIERKASSE7_MAIL_FROM=verrechnung@example.com
# BIERKASSE7_MAIL_FROM_NAME=Bierkasse Verrechnung
