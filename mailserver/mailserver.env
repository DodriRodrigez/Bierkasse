# Konfiguration für den eigenen Mailserver (docker-mailserver).
# Wird über docker-compose.mail.yml als env_file eingelesen.

# Log-Stufe: trace | debug | info | warn | error
LOG_LEVEL=info

# Container im selben Docker-Netz (die Bierkasse7-App) dürfen ohne
# Anmeldung über den Server relayen.
PERMIT_DOCKER=connected-networks

# Postmaster-Postfach (Pflicht-Kontaktadresse für Bounces)
POSTMASTER_ADDRESS=postmaster@example.com

# Virenscanner auf kleinen VPS abschalten (spart RAM)
ENABLE_CLAMAV=0

# Brute-Force-Schutz (empfohlen, benötigt NET_ADMIN)
ENABLE_FAIL2BAN=1

# Spamfilter + DKIM-Signierung über Rspamd (moderner Standard in v16).
ENABLE_RSPAMD=1
ENABLE_RSPAMD_REDIS=0

# Legacy-OpenDKIM deaktivieren – sonst Konflikt mit Rspamd (DKIM-Signierung).
ENABLE_OPENDKIM=0

# Kein POP3, IMAP wird nicht für den Versand gebraucht
ENABLE_POP3=0
ENABLE_IMAP=1

# TLS: leer = selbst-signiertes Zertifikat beim ersten Start.
# Für Produktion Let's Encrypt setzen (siehe mailserver/DNS-VORLAGE.md):
#   SSL_TYPE=letsencrypt
SSL_TYPE=
